{
  "name": "nexus-weaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present run build",
    "typecheck": "pnpm build && pnpm -r --sort --if-present run typecheck",
    "test": "pnpm build && vitest run",
    "lint": "eslint .",
    "dev": "pnpm --filter @nexus/cli dev",
    "pack:cli": "pnpm --filter @nexus/cli pack",
    "eval:baseline": "tsx packages/evals/src/cli.ts",
    "eval:security": "tsx packages/evals/src/security.ts",
    "eval:deepseek": "tsx packages/evals/src/deepseek-smoke.ts",
    "provider:smoke": "tsx packages/evals/src/provider-smoke.ts --provider deepseek",
    "test:providers": "vitest run packages/providers",
    "test:security": "vitest run packages/security packages/sandbox packages/tool-bus/src/index.test.ts packages/storage/src/index.test.ts packages/learning/src/index.test.ts",
    "test:tui": "vitest run packages/tui apps/cli/src/main.test.ts apps/cli/src/interactive.test.ts",
    "verify:package": "tsx packages/evals/src/package-dry-run.ts",
    "verify:release": "pnpm build && pnpm test && pnpm lint && pnpm typecheck && pnpm eval:baseline && pnpm eval:security && pnpm provider:smoke && pnpm verify:package && tsx packages/evals/src/release-verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "smol-toml": "^1.4.2",
    "zod": "^4.1.12"
  }
}
