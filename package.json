{
  "name": "nexus-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present run build",
    "typecheck": "pnpm build && pnpm -r --sort --if-present run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "pnpm --filter @ixayldz/nexus-cli dev",
    "pack:cli": "pnpm --filter @ixayldz/nexus-cli pack",
    "eval:baseline": "tsx packages/evals/src/cli.ts",
    "eval:security": "tsx packages/evals/src/security.ts",
    "eval:dogfood": "tsx packages/evals/src/dogfood.ts --live",
    "eval:deepseek": "tsx packages/evals/src/deepseek-smoke.ts",
    "provider:smoke": "tsx packages/evals/src/provider-smoke.ts --provider deepseek",
    "smoke:external": "tsx packages/evals/src/provider-smoke.ts --provider deepseek --require-live",
    "test:providers": "vitest run packages/providers",
    "test:security": "vitest run packages/security packages/sandbox packages/tool-bus/src/index.test.ts packages/storage/src/index.test.ts packages/learning/src/index.test.ts",
    "test:tui": "vitest run packages/tui apps/cli/src/main.test.ts apps/cli/src/interactive.test.ts",
    "verify:package": "tsx packages/evals/src/package-dry-run.ts",
    "verify:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm eval:baseline && pnpm eval:security && pnpm verify:package",
    "verify:external": "pnpm smoke:external",
    "verify:release": "pnpm verify:local && pnpm verify:external && pnpm eval:dogfood && tsx packages/evals/src/release-verify.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.13",
    "eslint": "^9.39.1",
    "prettier": "^3.9.4",
    "react-devtools-core": "^7.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "smol-toml": "^1.6.1",
    "zod": "^4.1.12"
  }
}
